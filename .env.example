# Copy to .env and fill in real values. Never commit .env.
#
# READSB_AIRCRAFT_URL: the collector runs inside a Docker container, so
# 127.0.0.1 means the container itself, not the host running readsb/tar1090.
# Use host.docker.internal instead -- compose.yaml adds the extra_hosts entry
# needed for that to resolve on Docker Engine for Linux (Docker Desktop
# provides it automatically). The path below is the common tar1090 layout;
# if your setup serves aircraft.json elsewhere, try /readsb/data/aircraft.json
# or /dump1090-fa/data/aircraft.json instead -- probe_readsb.py tries all
# three candidates for you if you're not sure which one applies.
READSB_AIRCRAFT_URL=http://host.docker.internal/tar1090/data/aircraft.json

# Receiver location (full precision). Never commit real values here in a
# tracked file -- this file is the .example template, leave blank.
RECEIVER_LAT=
RECEIVER_LON=

# Timezone for display purposes only; all DB timestamps are stored in UTC.
DISPLAY_TIMEZONE=Asia/Tokyo

# Collector polling behavior
POLL_INTERVAL_SECONDS=5
TRACK_SAMPLE_SECONDS=30
RAW_RETENTION_DAYS=30

# Database (adsb-db is not exposed to the host, only reachable on the
# internal Docker network -- see compose.yaml). POSTGRES_* are read by the
# adsb-db container itself; DATABASE_URL is what the app/migration use to
# connect and must reference the same user/password/db name.
POSTGRES_USER=adsb
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=adsb
DATABASE_URL=postgresql://adsb:replace-with-a-long-random-password@adsb-db:5432/adsb

# Web app bind address / port. Default is localhost-only; do not change to
# 0.0.0.0 or a LAN address without deliberately deciding to expose the app.
# For remote-but-private access (e.g. Tailscale), bind to that interface's
# own IP specifically (e.g. APP_BIND_HOST=100.x.y.z) rather than 0.0.0.0 --
# 0.0.0.0 also exposes the port on every other interface (LAN, etc.)
# unauthenticated, which is very likely not what you want.
APP_BIND_HOST=127.0.0.1
APP_PORT=8088

# Secondary loopback-only origin for Cloudflare Tunnel. This mapping is kept
# separate from APP_BIND_HOST so enabling Tunnel never changes Tailscale access.
CLOUDFLARE_ORIGIN_PORT=18088
# Optional separate anonymous hostname. Leave empty until the public-surface
# tests pass and a dedicated Tunnel route has been created.
PUBLIC_HOSTNAME=

# Map tile style for MapLibre GL JS, fetched client-side by the browser --
# the server never calls out to this URL. Leave unset to use the default,
# OpenFreeMap's free "positron" style (no API key needed). Override to a
# MapTiler style URL (with your own key) or a self-hosted style later.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Receiver marker privacy controls for the UI map.
MAP_SHOW_RECEIVER_MARKER=false
MAP_RECEIVER_MARKER_PRECISION=1

# Optional Slack/Discord-compatible daily-summary webhook, sent once per
# day (from adsb-daily-rollup, right after the previous day's rollup
# completes). Disabled by default -- leaving both unset is fine and does
# not affect startup. If you enable it, NOTIFY_WEBHOOK_URL is required
# (a Slack "Incoming Webhook" URL or a Discord webhook URL with
# `/slack` appended both accept this app's {"text": "..."} payload shape).
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=

# Two more independently opt-in webhook event types (Milestone KK), sent
# from adsb-collector as they happen rather than once a day. Both share
# NOTIFY_WEBHOOK_URL above -- set it if you enable either of these.
# Emergency squawk: fires once when an aircraft starts squawking
# 7500 (hijack) / 7600 (radio failure) / 7700 (general emergency), and
# does not repeat until it stops and starts again.
NOTIFY_EMERGENCY_SQUAWK_ENABLED=false
# Favorite aircraft seen: fires once when a favorited aircraft
# (/static/history.html's favorites star) starts being received, and does
# not repeat until it's no longer received and shows up again.
NOTIFY_FAVORITE_SEEN_ENABLED=false

# Optional: shows current METAR weather on /static/receiver.html, for
# correlating reception range/RSSI with weather (Milestone QQ). Set to
# the ICAO station code of your nearest airport (e.g. RJTT for Tokyo
# Haneda) -- there's no automatic "nearest airport" lookup. Leave unset
# to hide the feature entirely; no error either way.
METAR_STATION_ICAO=

# Optional: only needed if readsb's Beast-format TCP output (used by the
# /static/rawdata.html "raw data" page) is served from a different host
# or port than READSB_AIRCRAFT_URL. Defaults to READSB_AIRCRAFT_URL's own
# hostname and port 30005 (readsb's standard Beast-out port) -- leave both
# unset unless your setup is non-standard.
READSB_BEAST_HOST=
READSB_BEAST_PORT=
