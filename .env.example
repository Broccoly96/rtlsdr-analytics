# Copy to .env and fill in real values. Never commit .env.
#
# READSB_AIRCRAFT_URL: confirmed working endpoint on this host is the tar1090
# path below. PLAN.md's original candidate list (/readsb/..., /dump1090-fa/...)
# both 404 on this host; probe_readsb.py still tries them for portability.
READSB_AIRCRAFT_URL=http://127.0.0.1/tar1090/data/aircraft.json

# Receiver location (full precision). Never commit real values here in a
# tracked file -- this file is the .example template, leave blank.
RECEIVER_LAT=
RECEIVER_LON=

# Timezone for display purposes only; all DB timestamps are stored in UTC.
DISPLAY_TIMEZONE=Asia/Tokyo

# Collector polling behavior
POLL_INTERVAL_SECONDS=5
TRACK_SAMPLE_SECONDS=30
RAW_RETENTION_DAYS=30

# Database (adsb-db is not exposed to the host, only reachable on the
# internal Docker network -- see compose.yaml). POSTGRES_* are read by the
# adsb-db container itself; DATABASE_URL is what the app/migration use to
# connect and must reference the same user/password/db name.
POSTGRES_USER=adsb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=adsb
DATABASE_URL=postgresql://adsb:changeme@adsb-db:5432/adsb

# Web app bind address / port. Default is localhost-only; do not change to
# 0.0.0.0 or a LAN address without deliberately deciding to expose the app.
APP_BIND_HOST=127.0.0.1
APP_PORT=8088

# Map tile style for MapLibre GL JS, fetched client-side by the browser --
# the server never calls out to this URL. Leave unset to use the default,
# OpenFreeMap's free "positron" style (no API key needed). Override to a
# MapTiler style URL (with your own key) or a self-hosted style later.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Receiver marker privacy controls for the UI map.
MAP_SHOW_RECEIVER_MARKER=false
MAP_RECEIVER_MARKER_PRECISION=1
